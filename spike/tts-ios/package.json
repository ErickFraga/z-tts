    "expo-speech": "~13.0.0",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-sherpa-onnx": "^0.3.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "typescript": "~5.7.0"
  }
}
