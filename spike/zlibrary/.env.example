# Credenciais reais da conta Z-Library. Copie para .env e preencha.
# NUNCA versione o .env — ele está no .gitignore.
ZLIB_EMAIL=
ZLIB_PASSWORD=

# Domínio base — primeiro candidato da descoberta automática. Se ele responder,
# nenhum outro é tentado.
ZLIB_BASE_URL=https://z-library.sk

# Lista de candidatos, separada por vírgula, no lugar das sementes de
# src/domains.ts. A lista dinâmica do CDN continua valendo.
# ZLIB_DOMAINS=https://z-lib.fm,https://1lib.sk

# 0 desliga a descoberta e testa apenas ZLIB_BASE_URL — útil para isolar um
# domínio específico sem que o probe caia em outro pelo caminho.
# ZLIB_AUTO_DISCOVER=1

# 1 sonda todos os candidatos e fica com o de menor latência, em vez de parar no
# primeiro que responder. Mapeia quais espelhos esta rede alcança.
# ZLIB_RANK_DOMAINS=0

# Tentativas por requisição, contando a primeira. Aumente em rede instável.
# ZLIB_RETRIES=4

# Roteia todo o tráfego por um proxy seu. O spike não provê nenhum.
# ZLIB_PROXY=http://127.0.0.1:8080

# Termo usado na busca de teste.
ZLIB_SEARCH_TERM=Machado de Assis
